# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Anthropic API key (optional — needed for /ask command's LLM answers)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding model (default: all-MiniLM-L6-v2, runs locally on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_data

# Number of chunks to retrieve for RAG
TOP_K=5

# Chunk size in characters (~500 tokens)
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# LLM provider: "ollama" or "claude"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

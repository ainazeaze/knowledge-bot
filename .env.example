# Groq API (used by the agentic retrieval graph for grading and query rewriting)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embedding model (runs locally, no API needed)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Re-ranking model (cross-encoder, runs locally)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_data

# Number of chunks to retrieve per search
TOP_K=5

# Chunk size in characters
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
